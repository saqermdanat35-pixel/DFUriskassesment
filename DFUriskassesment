function verifyRecoveryAnswer(){
  const recoveryUsername = document.getElementById('emergencyUsername')?.value.trim() || getActiveUsername();
  const account = getAccountForUsername(recoveryUsername) || getAccount();
  if(!account) return false;
  if(account.recoveryCode){
    const code = document.getElementById('emergencyRecoveryCode')?.value.trim().toUpperCase() || '';
    return code === account.recoveryCode.toUpperCase();
  }
  if(account.recoverySpecialty && account.recoveryWorkplace){
    const specialty = document.getElementById('emergencyRecoverySpecialty')?.value.trim() || '';
    const workplace = document.getElementById('emergencyRecoveryWorkplace')?.value.trim() || '';
    return specialty === account.recoverySpecialty && workplace === account.recoveryWorkplace;
  }
  const answer = document.getElementById('emergencySecurityAnswer')?.value.trim().toLowerCase() || '';
  return !!account.securityAnswer && answer === account.securityAnswer;
}

function emergencyResetAccess(){
  const username = document.getElementById('emergencyUsername').value.trim();
  const next = document.getElementById('emergencyNewPassword').value;
  const confirm = document.getElementById('emergencyConfirmPassword').value;
  const account = getAccountForUsername(username);
  const status = document.getElementById('authStatus');

  if(!account){
    status.textContent = 'No account found on this device.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(username !== account.username){
    status.textContent = 'Username is incorrect.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(!account.recoveryCode && !account.recoverySpecialty && !(account.securityQuestion && account.securityAnswer)){
    status.textContent = 'This account does not have a recovery method yet.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(!next || next.length < 4){
    status.textContent = 'New password must be at least 4 characters.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(next !== confirm){
    status.textContent = 'New password and confirmation do not match.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(!verifyRecoveryAnswer()){
    status.textContent = account.recoveryCode ? 'Recovery code is incorrect.' : 'Recovery details are incorrect.';
    status.style.color = 'var(--danger)';
    return;
  }
  const confirmed = window.confirm('Reset the local account on this device and keep all patient records?');
  if(!confirmed) return;

  setAccount({
    username: account.username,
    password: next,
    recoveryCode: account.recoveryCode || generateRecoveryCode(),
    recoverySpecialty: account.recoverySpecialty,
    recoveryWorkplace: account.recoveryWorkplace,
    securityQuestion: account.securityQuestion,
    securityAnswer: account.securityAnswer,
    createdAt: account.createdAt
  });
  status.textContent = 'Device access reset completed. Patient data was kept.';
  status.style.color = 'var(--success)';
  ['emergencyUsername','emergencyRecoveryCode','emergencyNewPassword','emergencyConfirmPassword','emergencySecurityAnswer','emergencyRecoverySpecialty','emergencyRecoveryWorkplace'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.value = '';
