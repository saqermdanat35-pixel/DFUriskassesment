async function syncFromSharedStorage(force=false){
  await restorePatientsFromIndexedDBIfNeeded();
  const snapshot = getSyncSnapshot();
  const changed = force ||
    snapshot.account !== lastSeenAccountRaw ||
    snapshot.patients !== lastSeenPatientsRaw ||
    snapshot.login !== lastSeenLoginRaw ||
    snapshot.pulse !== lastSeenSyncPulse;

  if(!changed) return;

  refreshViewAfterExternalSync();
}

function setupCrossWindowSync(){
  captureSyncSnapshot();

  window.addEventListener('storage', event => {
    const watchedKeys = [
      STORAGE_KEYS.account,
      STORAGE_KEYS.accounts,
      STORAGE_KEYS.activeUser,
      STORAGE_KEYS.patients,
      STORAGE_KEYS.patientsByUser,
      STORAGE_KEYS.login,
      STORAGE_KEYS.autoBackup,
      SYNC_KEYS.pulse
    ];
    if(watchedKeys.includes(event.key)){
      syncFromSharedStorage(true);
    }
  });

  if(typeof BroadcastChannel !== 'undefined'){
    try{
      syncChannel = new BroadcastChannel('dfu_app_sync_channel_v1');
      syncChannel.addEventListener('message', () => syncFromSharedStorage(true));
    }catch(error){
      console.warn('BroadcastChannel unavailable:', error);
    }
  }

  window.setInterval(() => syncFromSharedStorage(false), SYNC_PULSE_INTERVAL_MS);
}


