}

function notifyDataSync(reason='update'){
  const payload = JSON.stringify({
    reason,
    at: new Date().toISOString()
  });
  try{
    storage.setItem(SYNC_KEYS.pulse, payload);
  }catch(error){
    console.warn('Sync pulse failed:', error);
  }
  if(syncChannel){
    try{
      syncChannel.postMessage(payload);
    }catch(error){
      console.warn('Broadcast sync failed:', error);
    }
  }
  captureSyncSnapshot();
}

