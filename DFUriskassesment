let currentLanguage = 'en';

function setLanguage(lang){
  currentLanguage = lang === 'ar' ? 'ar' : 'en';
  try{ storage.setItem('dfu_language_v1', currentLanguage); }catch(e){}
  applyTranslations();
}

function applyTranslations(){
  try{
    currentLanguage = storage.getItem('dfu_language_v1') || currentLanguage || 'en';
  }catch(e){}
  const isArabic = currentLanguage === 'ar';
  document.documentElement.lang = isArabic ? 'ar' : 'en';
  document.documentElement.dir = 'ltr';

  const appScreen = document.getElementById('appScreen');
  const authScreen = document.getElementById('authScreen');
  if(appScreen) appScreen.setAttribute('dir', isArabic ? 'rtl' : 'ltr');
  if(authScreen) authScreen.setAttribute('dir', 'ltr');

  const sel = document.getElementById('languageSelect');
  if(sel) sel.value = currentLanguage;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    const pack = LANGUAGE_PACK[currentLanguage] || LANGUAGE_PACK.en;
    if(pack[key]) el.textContent = pack[key];
  });
  const metabolicEl = document.getElementById('metabolic');
  if(metabolicEl && !metabolicEl.querySelector('ul') && !metabolicEl.querySelector('li')) metabolicEl.textContent = t('no_selected_factors_yet');
  const combEl = document.getElementById('comb');
  if(combEl && !combEl.querySelector('ul') && !combEl.querySelector('li')) combEl.textContent = t('no_selected_comb_risks_yet');
  updateSummary();
  calculate();
  allQuestions.forEach(q => {
    const qEl = document.querySelector(`#yes-${q.id}`)?.closest('.question')?.querySelector('.qtext');
    if(qEl){ qEl.textContent = isArabic ? (QUESTION_TRANSLATIONS_AR[q.id] || q.text) : q.text; }
    const yesBtn = document.getElementById(`yes-${q.id}`);
    const noBtn = document.getElementById(`no-${q.id}`);
    if(yesBtn) yesBtn.textContent = isArabic ? 'نعم' : 'Yes';
    if(noBtn) noBtn.textContent = isArabic ? 'لا' : 'No';
  });
}

