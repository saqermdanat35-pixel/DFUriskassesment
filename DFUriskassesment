  });

  [
    ['loginUsername','login'],['loginPassword','login'],
    ['signupUsername','signup'],['signupPassword','signup'],['signupConfirmPassword','signup'],
    ['changeUsername','changePassword'],['currentPassword','changePassword'],['newPassword','changePassword'],['confirmPassword','changePassword'],
    ['emergencyUsername','emergencyResetAccess'],['emergencyRecoveryCode','emergencyResetAccess'],['emergencyNewPassword','emergencyResetAccess'],['emergencyConfirmPassword','emergencyResetAccess']
  ].forEach(([id, fnName]) => {
    const field = document.getElementById(id);
    if(!field) return;
    field.addEventListener('keydown', event => {
      if(event.key === 'Enter' && typeof window[fnName] === 'function'){
