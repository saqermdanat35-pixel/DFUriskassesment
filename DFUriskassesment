function clearDirectoryFilters(){
  const search = document.getElementById('patientSearch');
  const risk = document.getElementById('riskFilter');
  const archive = document.getElementById('archiveFilter');
  if(search) search.value = '';
  if(risk) risk.value = '';
  if(archive) archive.value = 'active';
  currentDirectoryLetter = 'ALL';
  renderPatientsList();
}

function buildAlphabetBar(){
  const holder = document.getElementById('alphabetBar');
  if(!holder) return;
  holder.innerHTML = DIRECTORY_LETTERS.map(letter => `
    <button class="alpha-btn ${letter === currentDirectoryLetter ? 'active-alpha' : ''}" type="button" onclick="setDirectoryLetter('${letter}')">${letter}</button>
  `).join('');
}

function setDirectoryLetter(letter){
  currentDirectoryLetter = letter;
  renderPatientsList();
}

function getLatestAssessmentForPatient(patient){
  return patient && patient.assessments && patient.assessments.length ? patient.assessments[0] : null;
}

function getFilteredSortedPatients(){
  const search = (document.getElementById('patientSearch')?.value || '').toLowerCase().trim();
  const riskFilter = document.getElementById('riskFilter')?.value || '';
  const archiveFilter = document.getElementById('archiveFilter')?.value || 'active';
  let patients = [...getPatients()];

  if(archiveFilter === 'active') patients = patients.filter(p => !p.archived);
  if(archiveFilter === 'archived') patients = patients.filter(p => p.archived);
  if(riskFilter) patients = patients.filter(p => (p.latestRisk || '') === riskFilter);

  if(search){
    patients = patients.filter(p =>
      (p.patientName || '').toLowerCase().includes(search) ||
      (p.patientId || '').toLowerCase().includes(search) ||
      (p.physician || '').toLowerCase().includes(search) ||
      (p.clinic || '').toLowerCase().includes(search)
    );
  }

  if(currentDirectoryLetter !== 'ALL'){
    patients = patients.filter(p => ((p.patientName || '').trim().charAt(0).toUpperCase() || '#') === currentDirectoryLetter);
  }

  patients.sort((a,b) => (a.patientName || '').localeCompare((b.patientName || ''), undefined, { sensitivity: 'base' }));
  return patients;
}


function renderAutoBackupBadge(){
  const meta = getAutoBackupMeta();
  if(!meta || !meta.savedAt) return '<div class="backup-badge">Auto backup not saved yet</div>';
  const when = new Date(meta.savedAt);
  const label = Number.isNaN(when.getTime()) ? meta.savedAt : when.toLocaleString();
  return `<div class="backup-badge">Automatic backup saved: ${escapeHtml(label)}</div>`;
}

function updateCurrentPatientHub(){
  const holder = document.getElementById('currentPatientHub');
  if(!holder) return;
  const patient = getCurrentPatientObject();
  if(!patient){
    holder.innerHTML = `
      <div class="hub-empty">
        <h3 style="margin:0 0 6px;">${escapeHtml(t('no_active_patient_selected'))}</h3>
        <div class="small">${escapeHtml(t('start_or_open_patient'))}</div>
