    try{
      const payload = JSON.parse(String(reader.result || ''));
      const hasMultiBackup = payload && payload.accounts && typeof payload.accounts === 'object' && payload.patientsByUser && typeof payload.patientsByUser === 'object';
      if(!payload || (!hasMultiBackup && !Array.isArray(payload.patients))) throw new Error('Invalid backup file.');
