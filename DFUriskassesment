function migrateSingleAccountToMulti(){
  try{
    const existingAccounts = getAccounts();
    if(Object.keys(existingAccounts).length) return;
    const singleAccount = normalizeAccount(JSON.parse(storage.getItem(STORAGE_KEYS.account) || 'null'));
    if(!isUsableAccount(singleAccount)) return;
    const usernameKey = normalizeUsername(singleAccount.username);
    existingAccounts[usernameKey] = singleAccount;
    setAccounts(existingAccounts);
