  updateCurrentPatientHub();

  if(currentPatientId && currentPatientExists){
    if(currentAssessmentId){
      openAssessment(currentPatientId, currentAssessmentId);
    }else{
      openPatient(currentPatientId);
    }
  }else if(currentPatientId && !getCurrentPatientObject()){
    currentPatientId = null;
    currentAssessmentId = null;
    creatingNewPatient = true;
    resetForm(false);
  }

  if(loggedIn){
    openApp();
  }else{
    showAuthScreen(hasAccount() ? 'login' : 'signup');
  }

  captureSyncSnapshot();
  setStatusMessage('Data synchronized from another open copy.', 'var(--success)');
}

