  lines.push('');
  lines.push('Follow up:');
  lines.push((data.plan.followUp || '').replace(/^Follow up:\s*/i, '').trim() || labels.none_selected);
  lines.push('');
  lines.push('Education Game: https://pub-ac397c96ae2647d4a45221e91f4ce5dd.r2.dev/wja3qnv_Zc.html');
  return lines.join('\n');
}


function calculate(){
  const data = getAssessmentData();
  const scoreEl = document.getElementById('score');
  scoreEl.textContent = data.riskScore;
  scoreEl.className = 'score' + (data.riskScore === 'URGENT' ? ' urgent' : '');
  document.getElementById('riskStrip').textContent = data.plan.riskStrip;

  const flags = [
    `UrgentFlag: ${data.flags.UrgentFlag}`,
    `LOPSFlag: ${data.flags.LOPSFlag}`,
    `PADFlag: ${data.flags.PADFlag}`,
    `DeformityFlag: ${data.flags.DeformityFlag}`,
    `HistoryFlag: ${data.flags.HistoryFlag}`,
    `ESRDFlag: ${data.flags.ESRDFlag}`
  ];
  document.getElementById('flags').innerHTML = flags.map(f => `<span class="badge">${escapeHtml(f)}</span>`).join('');

  document.getElementById('metabolic').innerHTML = data.metabolic.length
    ? `<ul>${data.metabolic.map(x => `<li>${escapeHtml(x)}</li>`).join('')}</ul>`
    : `<span class="small">${escapeHtml(t('no_selected_factors_yet'))}</span>`;

  document.getElementById('comb').innerHTML = data.comb.length
    ? `<ul>${data.comb.map(x => `<li>${escapeHtml(x)}</li>`).join('')}</ul>`
    : `<span class="small">${escapeHtml(t('no_selected_comb_risks_yet'))}</span>`;

  document.getElementById('planTitle').textContent = data.plan.shortTitle;
  document.getElementById('planText').textContent = data.plan.full;
  document.getElementById('followUp').textContent = data.plan.followUp;
  document.getElementById('finalReport').textContent = buildReportText();

  updateProgress();
  renderAssessmentHistory();
}


function getCurrentPatientObject(){
  return getPatients().find(p => p.id === currentPatientId) || null;
}

function validateBeforeSave(){
  const fields = getPatientFields();
  const missing = [];
  if(!fields.assessmentDate) missing.push('Assessment date');
  if(!fields.patientName) missing.push('Patient name');
  if(!fields.patientId) missing.push('Patient ID');
  if(!fields.physician) missing.push('Physician');
  if(Object.keys(answers).length === 0) missing.push('At least one answered question');
  return missing;
}

function saveAssessment(){
  const missing = validateBeforeSave();
  const status = document.getElementById('status');
  if(missing.length){
    status.textContent = `Please complete: ${missing.join(', ')}.`;
    status.style.color = 'var(--danger)';
    return;
  }

  const patients = getPatients();
  const fields = getPatientFields();
  const data = getAssessmentData();

  let patient = patients.find(p => p.id === currentPatientId);

  if(!patient || creatingNewPatient){
    patient = {
      id: uid('patient'),
      archived: false,
      patientName: fields.patientName,
      patientId: fields.patientId,
      patientAge: fields.patientAge,
      patientGender: fields.patientGender,
      physician: fields.physician,
      clinic: fields.clinic,
      notes: fields.patientNotes,
      latestRisk: data.riskScore,
      assessments: []
    };
    patients.unshift(patient);
    currentPatientId = patient.id;
    creatingNewPatient = false;
  }else{
    patient.patientName = fields.patientName;
    patient.patientId = fields.patientId;
    patient.patientAge = fields.patientAge;
    patient.patientGender = fields.patientGender;
    patient.physician = fields.physician;
    patient.clinic = fields.clinic;
    patient.notes = fields.patientNotes;
    patient.latestRisk = data.riskScore;
  }

  let assessment = patient.assessments.find(a => a.id === currentAssessmentId);
  if(!assessment){
    assessment = { id: uid('assessment') };
    patient.assessments.unshift(assessment);
    currentAssessmentId = assessment.id;
  }

  assessment.assessmentDate = fields.assessmentDate;
  assessment.visitLabel = fields.visitLabel;
  assessment.patientSnapshot = { ...fields };
  assessment.answers = { ...answers };
  assessment.riskScore = data.riskScore;
  assessment.report = buildReportText();
  assessment.updatedAt = new Date().toISOString();

  patient.latestRisk = data.riskScore;
  setPatients(patients);
  renderPatientsList();
  renderAssessmentHistory();
  status.textContent = 'Assessment saved on this device.';
  status.style.color = 'var(--success)';
}

function startNewPatient(){
  creatingNewPatient = true;
  currentPatientId = null;
  currentAssessmentId = null;
  resetForm(false);
  renderPatientsList();
  showAppView('workspace');
  setStatusMessage('Ready for a new patient record.', 'var(--success)');
}


function openPatientPicker(){
  const modal = document.getElementById('patientPickerModal');
  if(!modal) return;
  modal.classList.remove('hidden');
  document.getElementById('patientPickerSearch').value = '';
  renderPatientPickerList();
}

function closePatientPicker(){
  const modal = document.getElementById('patientPickerModal');
  if(modal) modal.classList.add('hidden');
}

function renderPatientPickerList(){
  const holder = document.getElementById('patientPickerList');
  if(!holder) return;
  const query = (document.getElementById('patientPickerSearch').value || '').toLowerCase().trim();
  let patients = getPatients().filter(p => !p.archived);
  if(query){
    patients = patients.filter(p =>
      (p.patientName || '').toLowerCase().includes(query) ||
      (p.patientId || '').toLowerCase().includes(query) ||
      (p.physician || '').toLowerCase().includes(query) ||
      (p.clinic || '').toLowerCase().includes(query)
    );
  }
  patients.sort((a,b) => (a.patientName || '').localeCompare((b.patientName || ''), undefined, { sensitivity: 'base' }));

  if(!patients.length){
    holder.innerHTML = '<div class="small">No active patients match this search.</div>';
    return;
  }

  holder.innerHTML = patients.map(patient => {
    const latest = getLatestAssessmentForPatient(patient);
    const visits = patient.assessments ? patient.assessments.length : 0;
    return `
      <div class="patient-item">
        <h4>${escapeHtml(patient.patientName || 'Unnamed patient')}</h4>
        <div class="small">ID: ${escapeHtml(patient.patientId || '—')} | Physician: ${escapeHtml(patient.physician || '—')}</div>
        <div class="small">Latest status: ${escapeHtml(latest?.riskScore || patient.latestRisk || '—')} | Previous visits: ${visits}</div>
        <div class="toolbar" style="margin-top:10px;">
          <button class="primary" onclick="choosePatientForNewAssessment('${patient.id}')">Select patient</button>
        </div>
      </div>`;
  }).join('');
}

function choosePatientForNewAssessment(patientId){
  openPatient(patientId);
  closePatientPicker();
  currentAssessmentId = null;
  const patient = getCurrentPatientObject();
  const fields = patient ? {
    patientName: patient.patientName || '',
    patientId: patient.patientId || '',
    patientAge: patient.patientAge || '',
    patientGender: patient.patientGender || '',
    physician: patient.physician || '',
    clinic: patient.clinic || '',
    patientNotes: patient.notes || ''
  } : {};
  resetForm(false);
  document.getElementById('patientName').value = fields.patientName || '';
  document.getElementById('patientId').value = fields.patientId || '';
  document.getElementById('patientAge').value = fields.patientAge || '';
  document.getElementById('patientGender').value = fields.patientGender || '';
  document.getElementById('physician').value = fields.physician || '';
  document.getElementById('clinic').value = fields.clinic || '';
  document.getElementById('patientNotes').value = fields.patientNotes || '';
  setTodayDate();
  updateSummary();
  renderPatientsList();
  showAppView('workspace');
  setStatusMessage('Ready for a new assessment for the selected patient.', 'var(--success)');
}

function startNewAssessment(){
  const activePatients = getPatients().filter(p => !p.archived);
  if(!activePatients.length){
    setStatusMessage('Create a patient first before starting a new assessment.', 'var(--danger)');
    return;
  }
  openPatientPicker();
}

function clearQuestionAnswers(){
  Object.keys(answers).forEach(key => delete answers[key]);
  updateButtons();
  calculate();
  setStatusMessage('Question answers cleared. Patient information kept.', 'var(--success)');
}

function openPatient(patientId){
  const patient = getPatients().find(p => p.id === patientId);
  if(!patient) return;
  currentPatientId = patient.id;
  creatingNewPatient = false;

  if(patient.assessments.length){
    openAssessment(patient.id, patient.assessments[0].id);
  }else{
    resetForm(false);
    document.getElementById('patientName').value = patient.patientName || '';
    document.getElementById('patientId').value = patient.patientId || '';
    document.getElementById('patientAge').value = patient.patientAge || '';
    document.getElementById('patientGender').value = patient.patientGender || '';
    document.getElementById('physician').value = patient.physician || '';
    document.getElementById('clinic').value = patient.clinic || '';
    document.getElementById('patientNotes').value = patient.notes || '';
    setTodayDate();
    updateSummary();
    calculate();
  }

  renderPatientsList();
  renderAssessmentHistory();
  showAppView('workspace');
}

function openAssessment(patientId, assessmentId){
  const patient = getPatients().find(p => p.id === patientId);
  if(!patient) return;
  const assessment = patient.assessments.find(a => a.id === assessmentId);
  if(!assessment) return;

  currentPatientId = patientId;
  currentAssessmentId = assessmentId;
  creatingNewPatient = false;

  const snap = assessment.patientSnapshot || {};
  document.getElementById('assessmentDate').value = snap.assessmentDate || '';
  document.getElementById('patientName').value = snap.patientName || patient.patientName || '';
  document.getElementById('patientId').value = snap.patientId || patient.patientId || '';
  document.getElementById('patientAge').value = snap.patientAge || patient.patientAge || '';
  document.getElementById('patientGender').value = snap.patientGender || patient.patientGender || '';
  document.getElementById('physician').value = snap.physician || patient.physician || '';
  document.getElementById('clinic').value = snap.clinic || patient.clinic || '';
  document.getElementById('visitLabel').value = snap.visitLabel || assessment.visitLabel || '';
  document.getElementById('patientNotes').value = snap.patientNotes || patient.notes || '';

  Object.keys(answers).forEach(key => delete answers[key]);
  Object.entries(assessment.answers || {}).forEach(([key, value]) => {
    answers[Number(key)] = value;
  });

  updateButtons();
  updateSummary();
  calculate();
  renderPatientsList();
  renderAssessmentHistory();
  showAppView('workspace');
  setStatusMessage('Assessment loaded.', 'var(--success)');
}

function renderAssessmentHistory(){
  const holder = document.getElementById('assessmentHistory');
  const patient = getCurrentPatientObject();
  if(!patient || !patient.assessments.length){
    holder.innerHTML = '<div class="small">No saved assessments for the current patient.</div>';
    return;
  }
  holder.innerHTML = patient.assessments.map(a => `
    <div class="patient-item ${a.id === currentAssessmentId ? 'active' : ''}">
      <h4>${escapeHtml(a.patientSnapshot?.visitLabel || 'Assessment')}</h4>
      <div class="small">${escapeHtml(a.assessmentDate || '')} | Risk: ${escapeHtml(a.riskScore || '')}</div>
      <div class="toolbar" style="margin-top:10px;">
        <button onclick="openAssessment('${patient.id}', '${a.id}')">Open</button>
      </div>
    </div>
  `).join('');
}

function archiveCurrentPatient(){
  if(!currentPatientId){
    document.getElementById('status').textContent = 'No patient selected.';
    document.getElementById('status').style.color = 'var(--danger)';
    return;
  }
  const patients = getPatients();
  const patient = patients.find(p => p.id === currentPatientId);
  if(!patient) return;
  patient.archived = true;
  setPatients(patients);
  renderPatientsList();
  document.getElementById('status').textContent = 'Patient archived.';
  document.getElementById('status').style.color = 'var(--success)';
}

function renderPatientsList(){
  updateCurrentPatientHub();
  renderPatientDirectory();
}

function deletePatient(patientId){
  const confirmed = window.confirm('Delete this patient and all local assessments on this device?');
  if(!confirmed) return;
  let patients = getPatients();
  patients = patients.filter(p => p.id !== patientId);
  setPatients(patients);

  if(currentPatientId === patientId){
    currentPatientId = null;
    currentAssessmentId = null;
    creatingNewPatient = true;
    resetForm(false);
  }
  renderPatientsList();
  renderAssessmentHistory();
  document.getElementById('status').textContent = 'Patient deleted.';
  document.getElementById('status').style.color = 'var(--success)';
}

function downloadReport(){
  const text = buildReportText();
  const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  const name = document.getElementById('patientName').value.trim() || 'patient';
  a.href = URL.createObjectURL(blob);
  a.download = `${name.replace(/[^a-z0-9]/gi,'_').toLowerCase()}_dfu_report.txt`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(a.href);
  setStatusMessage('Report downloaded.', 'var(--success)');
}

function resetForm(confirmReset = true){
  if(confirmReset && Object.keys(answers).length > 0){
    const confirmed = window.confirm('Reset the form and clear the current assessment data?');
    if(!confirmed) return;
  }

  document.getElementById('assessmentDate').value = '';
  document.getElementById('patientName').value = '';
  document.getElementById('patientId').value = '';
  document.getElementById('patientAge').value = '';
  document.getElementById('patientGender').value = '';
  document.getElementById('physician').value = '';
  document.getElementById('clinic').value = '';
  document.getElementById('visitLabel').value = '';
  document.getElementById('patientNotes').value = '';
  Object.keys(answers).forEach(key => delete answers[key]);
  fullPlanVisible = true;
  currentAssessmentId = null;

  setTodayDate();
  updateSummary();
  updateButtons();
  calculate();

  document.getElementById('status').textContent = 'Form reset and ready.';
  document.getElementById('status').style.color = 'var(--success)';
}

function fillFormForTesting(yesIds){
  Object.keys(answers).forEach(key => delete answers[key]);
  updateSummary();
  calculate();
  allQuestions.forEach(q => {
    answers[q.id] = yesIds.includes(q.id) ? 'yes' : 'no';
  });
  updateButtons();
  calculate();
  return getAssessmentData().riskScore;
}

function runSelfTests(){
  const results = [];
  results.push(['All yes -> URGENT', fillFormForTesting(allQuestions.map(q => q.id)) === 'URGENT']);
  results.push(['LOPS only by Q13 -> 1', fillFormForTesting([13]) === '1']);
  results.push(['PAD only by Q14 -> 1', fillFormForTesting([14]) === '1']);
  results.push(['LOPS + PAD -> 2', fillFormForTesting([13,14]) === '2']);
  results.push(['LOPS + deformity -> 2', fillFormForTesting([21,23]) === '2']);
  results.push(['History Q1 alone -> 0', fillFormForTesting([1]) === '0']);
  results.push(['LOPS + history -> 3', fillFormForTesting([13,1]) === '3']);
  results.push(['PAD + ESRD -> 3', fillFormForTesting([14,7]) === '3']);
  results.push(['Urgent by Q15 -> URGENT', fillFormForTesting([15]) === 'URGENT']);
  results.push(['Q12 alone -> 0 after removing from LOPS', fillFormForTesting([12]) === '0']);
  fillFormForTesting([]);
  return results;
}

function bootstrap(){
  if(!hasAccount()){
    setLoginState(false);
  }

let lastSyncFingerprint = '';

function getSyncFingerprint(){
  return [
    storage.getItem(STORAGE_KEYS.account) || '',
    storage.getItem(STORAGE_KEYS.accounts) || '',
    storage.getItem(STORAGE_KEYS.activeUser) || '',
    storage.getItem(STORAGE_KEYS.patients) || '',
    storage.getItem(STORAGE_KEYS.patientsByUser) || '',
    storage.getItem(STORAGE_KEYS.login) || ''
  ].join('||');
}

function applyExternalStateRefresh(){
  renderPatientsList();
  renderAssessmentHistory();
  updateCurrentPatientHub();
  const current = getCurrentPatientObject();
  if(!current && !creatingNewPatient){
    startNewPatient();
  }else{
    updateSummary();
    calculate();
  }
}

function notifyDataChanged(){
  try{
    lastSyncFingerprint = getSyncFingerprint();
    storage.setItem('dfu_app_last_change_v4_20260419', String(Date.now()));
  }catch(e){}
  try{
    if(window.dfuSyncChannel) window.dfuSyncChannel.postMessage({type:'state-changed', at: Date.now()});
  }catch(e){}
}

function setupCrossTabSync(){
  lastSyncFingerprint = getSyncFingerprint();

  try{
    if('BroadcastChannel' in window){
      window.dfuSyncChannel = new BroadcastChannel('dfu_app_sync_channel');
      window.dfuSyncChannel.onmessage = function(){
        const nextFingerprint = getSyncFingerprint();
        if(nextFingerprint !== lastSyncFingerprint){
          lastSyncFingerprint = nextFingerprint;
          applyExternalStateRefresh();
        }
      };
    }
  }catch(error){
    console.warn('BroadcastChannel unavailable:', error);
  }

  window.addEventListener('storage', function(event){
    if([STORAGE_KEYS.account, STORAGE_KEYS.accounts, STORAGE_KEYS.activeUser, STORAGE_KEYS.patients, STORAGE_KEYS.patientsByUser, STORAGE_KEYS.login, 'dfu_app_last_change_v4_20260419'].includes(event.key)){
      const nextFingerprint = getSyncFingerprint();
      if(nextFingerprint !== lastSyncFingerprint){
        lastSyncFingerprint = nextFingerprint;
        applyExternalStateRefresh();
      }
    }
  });

  setInterval(function(){
    const nextFingerprint = getSyncFingerprint();
    if(nextFingerprint !== lastSyncFingerprint){
      lastSyncFingerprint = nextFingerprint;
      applyExternalStateRefresh();
    }
  }, 2000);
}

migrateLegacyStorage();
migrateSingleAccountToMulti();
setupCrossTabSync();
startRemoteSync();
  renderQuestions();
