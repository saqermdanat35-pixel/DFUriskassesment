function restoreAutoBackup(){
  const raw = storage.getItem(STORAGE_KEYS.autoBackup);
  if(!raw){
    setStatusMessage('No automatic backup is saved yet on this device.', 'var(--danger)');
    return;
  }
  try{
    const payload = JSON.parse(raw);
    const hasMultiBackup = payload && payload.accounts && typeof payload.accounts === 'object' && payload.patientsByUser && typeof payload.patientsByUser === 'object';
    if(!payload || (!hasMultiBackup && !Array.isArray(payload.patients))) throw new Error('Invalid auto backup format.');
    const confirmed = window.confirm('Restore the latest automatic backup on this device? This will replace the current local accounts and patient records.');
    if(!confirmed) return;

    if(hasMultiBackup){
      storage.setItem(STORAGE_KEYS.accounts, JSON.stringify(payload.accounts || {}));
      storage.setItem(STORAGE_KEYS.patientsByUser, JSON.stringify(payload.patientsByUser || {}));
      setActiveUsername('');
      storage.removeItem(STORAGE_KEYS.account);
      storage.removeItem(STORAGE_KEYS.patients);
      idbSaveAccountMirror(null);
      idbSavePatientsMirror([]);
    }else{
      if(payload.account){
        const restoredAccount = normalizeAccount(payload.account);
        if(restoredAccount && isUsableAccount(restoredAccount)){
          const key = normalizeUsername(restoredAccount.username);
          const accounts = getAccounts();
          accounts[key] = restoredAccount;
          setAccounts(accounts);
          const byUser = getPatientsByUser();
          byUser[key] = payload.patients || [];
          setPatientsByUser(byUser);
          setActiveUsername('');
          storage.removeItem(STORAGE_KEYS.account);
          storage.removeItem(STORAGE_KEYS.patients);
        }
      }
    }

    setLoginState(false);
    setActiveUsername('');

    currentPatientId = null;
    currentAssessmentId = null;
    creatingNewPatient = true;

    try{
      resetForm(false);
    }catch(resetError){
      console.warn('Reset after backup restore skipped:', resetError);
    }

    renderPatientsList();
    renderAssessmentHistory();
    updateCurrentPatientHub();

    const appScreen = document.getElementById('appScreen');
    const authScreen = document.getElementById('authScreen');
    if(appScreen) appScreen.classList.add('hidden');
    if(authScreen) authScreen.classList.remove('hidden');
    showAuthMode('login');

    notifyDataSync('restore-backup');
    setStatusMessage('Automatic backup restored. Please log in with the account you want to use.', 'var(--success)');
  }catch(error){
    console.error('Automatic backup restore failed:', error);
    setStatusMessage('Could not restore the automatic backup saved on this device.', 'var(--danger)');
  }
}

