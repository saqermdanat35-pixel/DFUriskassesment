<script>
/* Safe IndexedDB compatibility layer
   Keeps the original synchronous localStorage workflow working,
   while mirroring patient records into IndexedDB for larger datasets.
*/
const DFU_IDB_NAME = 'dfu_app_db_v4_20260419';
const DFU_IDB_VERSION = 3;
const DFU_PATIENT_STORE = 'patients';
const DFU_ACCOUNT_STORE = 'account';
const DFU_SESSION_STORE = 'session';

function shouldUseIndexedDB(){
  try{
    return typeof indexedDB !== 'undefined' && window.location.protocol !== 'file:';
  }catch(error){
    return false;
  }
}

function openDFUDatabase(){
  return new Promise((resolve, reject) => {
    if(!shouldUseIndexedDB()){
      reject(new Error('IndexedDB disabled for this browser/context.'));
      return;
    }
    const request = indexedDB.open(DFU_IDB_NAME, DFU_IDB_VERSION);
    request.onupgradeneeded = function(event){
      const db = event.target.result;
      if(!db.objectStoreNames.contains(DFU_PATIENT_STORE)){
        db.createObjectStore(DFU_PATIENT_STORE, { keyPath: 'id' });
      }
      if(!db.objectStoreNames.contains(DFU_ACCOUNT_STORE)){
        db.createObjectStore(DFU_ACCOUNT_STORE, { keyPath: 'key' });
      }
      if(!db.objectStoreNames.contains(DFU_SESSION_STORE)){
        db.createObjectStore(DFU_SESSION_STORE, { keyPath: 'key' });
      }
    };
    request.onsuccess = function(event){ resolve(event.target.result); };
    request.onerror = function(){ reject(request.error); };
  });
}

async function idbSavePatientsMirror(patients){
  try{
    const db = await openDFUDatabase();
    await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_PATIENT_STORE, 'readwrite');
      const store = tx.objectStore(DFU_PATIENT_STORE);
      store.clear();
      (patients || []).forEach(patient => store.put(patient));
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
    db.close();
  }catch(error){
    console.warn('IndexedDB mirror save skipped:', error);
  }
}

async function idbLoadPatientsMirror(){
  try{
    const db = await openDFUDatabase();
    const result = await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_PATIENT_STORE, 'readonly');
      const store = tx.objectStore(DFU_PATIENT_STORE);
      const req = store.getAll();
      req.onsuccess = () => resolve(req.result || []);
      req.onerror = () => reject(req.error);
    });
    db.close();
    return result;
  }catch(error){
    console.warn('IndexedDB mirror load skipped:', error);
    return [];
  }
}


async function idbSaveAccountMirror(account){
  try{
    const db = await openDFUDatabase();
    await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_ACCOUNT_STORE, 'readwrite');
      const store = tx.objectStore(DFU_ACCOUNT_STORE);
      if(account){
        store.put({ key: 'primary', value: account });
      }else{
        store.delete('primary');
      }
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
    db.close();
  }catch(error){
    console.warn('IndexedDB account save skipped:', error);
  }
}

async function idbLoadAccountMirror(){
  try{
    const db = await openDFUDatabase();
    const result = await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_ACCOUNT_STORE, 'readonly');
      const store = tx.objectStore(DFU_ACCOUNT_STORE);
      const req = store.get('primary');
      req.onsuccess = () => resolve(req.result ? req.result.value : null);
      req.onerror = () => reject(req.error);
    });
    db.close();
    return result;
  }catch(error){
    console.warn('IndexedDB account load skipped:', error);
    return null;
  }
}

async function idbSaveLoginMirror(isLoggedIn){
  try{
    const db = await openDFUDatabase();
    await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_SESSION_STORE, 'readwrite');
      const store = tx.objectStore(DFU_SESSION_STORE);
      if(isLoggedIn){
        store.put({ key: 'login', value: '1' });
      }else{
        store.delete('login');
      }
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
    db.close();
  }catch(error){
    console.warn('IndexedDB login save skipped:', error);
  }
}

async function idbLoadLoginMirror(){
  try{
    const db = await openDFUDatabase();
    const result = await new Promise((resolve, reject) => {
      const tx = db.transaction(DFU_SESSION_STORE, 'readonly');
      const store = tx.objectStore(DFU_SESSION_STORE);
      const req = store.get('login');
      req.onsuccess = () => resolve(req.result ? req.result.value : '');
      req.onerror = () => reject(req.error);
    });
    db.close();
    return result || '';
  }catch(error){
    console.warn('IndexedDB login load skipped:', error);
    return '';
  }
}

async function restoreStateFromIndexedDBIfNeeded(){
  if(!shouldUseIndexedDB()){
    return;
  }
  try{
    const localPatientsRaw = storage.getItem(STORAGE_KEYS.patients);
    const localPatients = localPatientsRaw ? JSON.parse(localPatientsRaw) : [];
    if(!Array.isArray(localPatients) || !localPatients.length){
      const mirroredPatients = await idbLoadPatientsMirror();
      if(Array.isArray(mirroredPatients) && mirroredPatients.length){
        storage.setItem(STORAGE_KEYS.patients, JSON.stringify(mirroredPatients));
        console.log('Patients restored from IndexedDB mirror.');
      }
    }

    if(!storage.getItem(STORAGE_KEYS.account)){
      const mirroredAccount = await idbLoadAccountMirror();
      if(mirroredAccount){
        storage.setItem(STORAGE_KEYS.account, JSON.stringify(mirroredAccount));
        console.log('Account restored from IndexedDB mirror.');
      }
    }

    if(!storage.getItem(STORAGE_KEYS.login)){
      const mirroredLogin = await idbLoadLoginMirror();
      if(mirroredLogin){
        storage.setItem(STORAGE_KEYS.login, mirroredLogin);
        console.log('Login state restored from IndexedDB mirror.');
      }
    }
  }catch(error){
    console.warn('Restore from IndexedDB mirror skipped:', error);
  }
}
</script>

<script>

const REMOTE_SYNC = {
  enabled: false,
  endpoint: '',
  apiKey: '',
  deviceIdKey: 'dfu_device_id_v1',
  syncIntervalMs: 15000
};

function getDeviceId(){
  let id = storage.getItem(REMOTE_SYNC.deviceIdKey);
  if(!id){
    id = uid('device');
    storage.setItem(REMOTE_SYNC.deviceIdKey, id);
  }
  return id;
}

async function pullRemoteState(){
  if(!REMOTE_SYNC.enabled || !REMOTE_SYNC.endpoint) return false;
  try{
    const response = await fetch(REMOTE_SYNC.endpoint + '?scope=dfu_app_state', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        ...(REMOTE_SYNC.apiKey ? {'Authorization': 'Bearer ' + REMOTE_SYNC.apiKey} : {})
      },
      cache: 'no-store'
    });
    if(!response.ok) return false;
    const payload = await response.json();
    if(!payload || !payload.state) return false;
    const state = payload.state;
    if(state.account !== undefined) storage.setItem(STORAGE_KEYS.account, JSON.stringify(state.account));
    if(state.patients !== undefined) storage.setItem(STORAGE_KEYS.patients, JSON.stringify(state.patients));
    if(state.login !== undefined){
      setLoginState(!!state.login);
    }
    return true;
  }catch(error){
    console.warn('Remote pull skipped:', error);
    return false;
  }
}

async function pushRemoteState(){
  if(!REMOTE_SYNC.enabled || !REMOTE_SYNC.endpoint) return false;
  try{
    const state = {
      account: getAccount(),
      patients: getPatients(),
      login: storage.getItem(STORAGE_KEYS.login) === '1',
      updatedAt: new Date().toISOString(),
      sourceDevice: getDeviceId()
    };
    const response = await fetch(REMOTE_SYNC.endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...(REMOTE_SYNC.apiKey ? {'Authorization': 'Bearer ' + REMOTE_SYNC.apiKey} : {})
      },
      body: JSON.stringify({scope: 'dfu_app_state', state})
    });
    return response.ok;
  }catch(error){
    console.warn('Remote push skipped:', error);
    return false;
  }
}

let remoteSyncTimer = null;
function startRemoteSync(){
  if(!REMOTE_SYNC.enabled || !REMOTE_SYNC.endpoint || remoteSyncTimer) return;
  remoteSyncTimer = setInterval(async () => {
    await pullRemoteState();
