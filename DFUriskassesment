function escapeHtml(value){
  return String(value ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'",'&#39;');
}

function uid(prefix='id'){
  return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2,8)}`;
}

function getAccount(){
  migrateSingleAccountToMulti();
  const active = getActiveUsername();
  if(active) return getAccountForUsername(active);
  const accounts = getAccounts();
  const keys = Object.keys(accounts);
  if(keys.length === 1) return getAccountForUsername(keys[0]);
  return null;
}

function getStoredAccountRaw(){
  try{
    const active = getActiveUsername();
    if(active) return normalizeAccount(getAccounts()[active]);
    return normalizeAccount(JSON.parse(storage.getItem(STORAGE_KEYS.account) || 'null'));
  }catch(e){
    return null;
  }
}

function isUsableAccount(account){
  return !!(account && String(account.username || '').trim() && String(account.password || '').length >= 4);
}

function setAccount(account){
  const normalized = normalizeAccount(account);
  if(!isUsableAccount(normalized)) return;
  const key = normalizeUsername(normalized.username);
  const accounts = getAccounts();
  normalized.updatedAt = new Date().toISOString();
  accounts[key] = normalized;
  setAccounts(accounts);
  setActiveUsername(key);
  storage.setItem(STORAGE_KEYS.account, JSON.stringify(normalized));
  idbSaveAccountMirror(normalized);
  saveAutoBackup('account');
  notifyDataSync('account');
}

function clearStoredAccount(){
  const active = getActiveUsername();
  if(active){
    const accounts = getAccounts();
    delete accounts[active];
    setAccounts(accounts);
    setActiveUsername('');
    storage.removeItem(STORAGE_KEYS.account);
    idbSaveAccountMirror(null);
    return;
  }
  storage.removeItem(STORAGE_KEYS.account);
  idbSaveAccountMirror(null);
}

function hasAccount(){
  migrateSingleAccountToMulti();
  return Object.keys(getAccounts()).some(key => isUsableAccount(normalizeAccount(getAccounts()[key])));
}

function showAuthMode(mode){
  document.getElementById('signupPanel').classList.toggle('hidden', mode !== 'signup');
  document.getElementById('loginPanel').classList.toggle('hidden', mode !== 'login');
  document.getElementById('changePasswordPanel').classList.toggle('hidden', mode !== 'change');
  document.getElementById('forgotPasswordPanel').classList.toggle('hidden', mode !== 'forgot');
  document.getElementById('authStatus').textContent = '';

  const workspaceBtn = document.getElementById('workspaceTabBtn');
  const directoryBtn = document.getElementById('directoryTabBtn');
  if(workspaceBtn) workspaceBtn.classList.toggle('active', mode === 'login');
  if(directoryBtn) directoryBtn.classList.toggle('active', mode === 'signup');

  if(mode === 'forgot') updateRecoveryMode();
}

function generateRecoveryCode(){
  const seg = () => Math.random().toString(36).slice(2,6).toUpperCase();
  return `DFU-${seg()}-${seg()}-${seg()}`;
}

function displayRecoveryCode(code, title='Recovery code'){
  window.prompt(`${title}

Copy and save this code in a safe place.`, code);
}

function ensureRecoveryCodeForExistingAccount(){
  const account = getAccount();
  if(!account || account.recoveryCode) return;
  const newCode = generateRecoveryCode();
  setAccount({
    username: account.username,
    password: account.password,
    recoveryCode: newCode,
    recoverySpecialty: account.recoverySpecialty,
    recoveryWorkplace: account.recoveryWorkplace,
    securityQuestion: account.securityQuestion,
    securityAnswer: account.securityAnswer,
    createdAt: account.createdAt
  });
  setTimeout(() => displayRecoveryCode(newCode, 'New recovery code'), 120);
}


function signup(){
  const username = document.getElementById('signupUsername').value.trim();
  const password = document.getElementById('signupPassword').value.trim();
  const confirm = document.getElementById('signupConfirmPassword').value.trim();
  const status = document.getElementById('authStatus');

  migrateSingleAccountToMulti();

  if(!username || username.length < 3){
    status.textContent = 'Username must be at least 3 characters.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(!password || password.length < 4){
    status.textContent = 'Password must be at least 4 characters.';
    status.style.color = 'var(--danger)';
    return;
  }
  if(password !== confirm){
    status.textContent = 'Password and confirmation do not match.';
    status.style.color = 'var(--danger)';
    return;
  }

  if(getAccountForUsername(username)){
    status.textContent = 'This username already exists on this device. Please log in with it or choose a different username.';
    status.style.color = 'var(--danger)';
    return;
  }

  const recoveryCode = generateRecoveryCode();
  setAccount({ username, password, recoveryCode, createdAt: new Date().toISOString() });
  const byUser = getPatientsByUser();
  const key = normalizeUsername(username);
  if(!Array.isArray(byUser[key])){
    byUser[key] = [];
    setPatientsByUser(byUser);
  }
  setLoginState(true);
  notifyDataSync('signup');
  status.textContent = 'Account created successfully.';
  status.style.color = 'var(--success)';
  try{ displayRecoveryCode(recoveryCode); }catch(error){ console.warn('Recovery code prompt skipped:', error); }
  clearAuthInputs();
  openApp();
}

async function login(){
  const username = document.getElementById('loginUsername').value.trim();
  const password = document.getElementById('loginPassword').value.trim();
  const status = document.getElementById('authStatus');

  if(!username || !password){
    status.textContent = 'Enter username and password.';
    status.style.color = 'var(--danger)';
    return;
  }

  migrateSingleAccountToMulti();
  let account = getAccountForUsername(username);
  if(!isUsableAccount(account)){
    await restoreStateFromIndexedDBIfNeeded();
    migrateSingleAccountToMulti();
    account = getAccountForUsername(username);
  }

  if(!isUsableAccount(account)){
    setLoginState(false);
    status.textContent = 'No account found for this username. Use First time setup to create it.';
    status.style.color = 'var(--danger)';
    return;
  }

  const passwordMatches = password === String(account.password || '').trim();
  if(passwordMatches){
    setActiveUsername(username);
    storage.setItem(STORAGE_KEYS.account, JSON.stringify(account));
    setLoginState(true);
    notifyDataSync('login');
    clearAuthInputs();
    openApp();
    status.textContent = '';
  }else{
    setLoginState(false);
    status.textContent = 'Incorrect username or password.';
    status.style.color = 'var(--danger)';
  }
}

