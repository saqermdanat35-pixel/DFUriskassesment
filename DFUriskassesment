function renderPatientDirectory(){
  buildAlphabetBar();
  const stats = document.getElementById('directoryStats');
  const holder = document.getElementById('directoryList');
  if(!holder || !stats) return;

  const patients = getFilteredSortedPatients();
  const allPatients = getPatients();
  const activeCount = allPatients.filter(p => !p.archived).length;
  const archivedCount = allPatients.filter(p => p.archived).length;
  stats.innerHTML = `
    <div class="directory-stat">Showing ${patients.length} patient(s)</div>
    <div class="directory-stat">Active ${activeCount}</div>
    <div class="directory-stat">Archived ${archivedCount}</div>
    <div class="directory-stat">Letter ${currentDirectoryLetter}</div>`;

  if(!patients.length){
    holder.innerHTML = '<div class="small">No matching patients for the selected filters.</div>';
    return;
  }

  holder.innerHTML = patients.map(p => {
    const latest = getLatestAssessmentForPatient(p);
    const historyPreview = (p.assessments || []).slice(0,3).map(a => `
      <div class="history-row">
        <span>${escapeHtml(a.patientSnapshot?.visitLabel || 'Assessment')}</span>
        <span>${escapeHtml(a.assessmentDate || '—')} • Risk ${escapeHtml(a.riskScore || '—')}</span>
      </div>
    `).join('') || `<div class="small">${escapeHtml(t('no_saved_visits_yet'))}</div>`;
    return `
      <div class="directory-card ${p.id === currentPatientId ? 'active' : ''}">
        <div class="directory-head">
          <div>
            <h4>${escapeHtml(p.patientName || 'Unnamed patient')}</h4>
            <div class="directory-sub">ID: ${escapeHtml(p.patientId || '—')} • ${escapeHtml(p.physician || '—')}</div>
          </div>
          <div class="directory-badges">
            <span class="pill">Risk ${escapeHtml(p.latestRisk || '—')}</span>
            ${p.archived ? '<span class="pill archived">Archived</span>' : ''}
          </div>
        </div>
        <div class="hub-meta" style="margin-top:12px;">
          <div class="mini"><strong>Visits</strong>${p.assessments?.length || 0}</div>
          <div class="mini"><strong>Latest visit</strong>${escapeHtml(latest?.assessmentDate || '—')}</div>
          <div class="mini"><strong>Previous status</strong>${escapeHtml(latest?.riskScore || p.latestRisk || '—')}</div>
          <div class="mini"><strong>Clinic</strong>${escapeHtml(p.clinic || '—')}</div>
        </div>
        <div class="directory-history">
          <div class="small"><strong>${escapeHtml(t('previous_visits'))}</strong></div>
          <div class="history-mini">${historyPreview}</div>
